DATABASE_URL=sqlite:///./supplysure.db
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Sarvam: speech-to-text, translation and the SupplyGPT reasoning model (D-03, D-49)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b
# LLM used for supplier-message intake: "sarvam" or "fake"
LLM_PROVIDER=sarvam
# The factory's "today" for phrases like "next Tuesday". The sample data is set in June 2027.
SUPPLYSURE_TODAY=2027-06-14
AUTONOMY_LEVEL=1
